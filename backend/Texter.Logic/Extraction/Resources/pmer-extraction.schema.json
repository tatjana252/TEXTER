{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entities",
    "relationships",
    "generalizations",
    "notes"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "displayName",
          "kind",
          "attributes",
          "attribution"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "normal",
              "weak"
            ]
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/attribute"
            }
          },
          "attribution": {
            "$ref": "#/$defs/attribution"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "displayName",
          "mapping1",
          "mapping2",
          "isWeak",
          "attributes",
          "attribution"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "mapping1": {
            "$ref": "#/$defs/mapping"
          },
          "mapping2": {
            "$ref": "#/$defs/mapping"
          },
          "isWeak": {
            "type": "boolean"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/attribute"
            }
          },
          "attribution": {
            "$ref": "#/$defs/attribution"
          }
        }
      }
    },
    "generalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "superEntity",
          "subEntities",
          "isDisjoint",
          "isTotal",
          "attribution"
        ],
        "properties": {
          "superEntity": {
            "type": "string"
          },
          "subEntities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isDisjoint": {
            "type": "boolean"
          },
          "isTotal": {
            "type": "boolean"
          },
          "attribution": {
            "$ref": "#/$defs/attribution"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "length",
        "isIdentifier",
        "isMultivalued",
        "isOptional",
        "attribution"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "tinyint",
            "smallint",
            "int",
            "long",
            "decimal",
            "money",
            "float",
            "bool",
            "char",
            "string",
            "text",
            "date",
            "time",
            "datetime",
            "uuid"
          ]
        },
        "length": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Length for string/char, otherwise null."
        },
        "isIdentifier": {
          "type": "boolean"
        },
        "isMultivalued": {
          "type": "boolean"
        },
        "isOptional": {
          "type": "boolean"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "domain",
        "coDomain",
        "lowerBound",
        "upperBound",
        "boundsStated"
      ],
      "properties": {
        "role": {
          "type": "string",
          "description": "camelCase navigation name from domain to coDomain, plural when upperBound is many."
        },
        "domain": {
          "type": "string"
        },
        "coDomain": {
          "type": "string"
        },
        "lowerBound": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "upperBound": {
          "type": "integer",
          "description": "-1 for M (many), otherwise a positive integer"
        },
        "boundsStated": {
          "type": "boolean"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentenceIds",
        "evidence",
        "confidence",
        "rationale"
      ],
      "properties": {
        "sentenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number"
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}