{
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "entities", "relationships", "generalizations", "notes"],
  "properties": {
    "facts": {
      "description": "Step 1: the facts the source states, each read from its sentences. The model is built only from these facts.",
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "generalizations": {
      "type": "array",
      "items": { "$ref": "#/$defs/generalization" }
    },
    "notes": {
      "description": "Ambiguities or missing information worth asking the analyst about.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sentenceIds", "statement"],
      "properties": {
        "id": {
          "description": "Fact identifier: F1, F2, ... in order.",
          "type": "string",
          "pattern": "^F[1-9][0-9]*$"
        },
        "sentenceIds": {
          "description": "Source sentence IDs this fact is read from.",
          "type": "array",
          "items": { "type": "string", "pattern": "^S[1-9][0-9]*$" }
        },
        "statement": {
          "description": "One atomic fact about the domain, in the words of the text, not in modeling vocabulary.",
          "type": "string"
        }
      }
    },
    "evidence": {
      "description": "IDs of the facts this element or decision rests on, for example F2. Empty when no stated fact carries it.",
      "type": "array",
      "items": { "type": "string", "pattern": "^F[1-9][0-9]*$" }
    },
    "confidence": {
      "description": "stated (a cited fact names it), inferred (a modeling decision read out of the facts) or assumed (no fact supports it; evidence is empty).",
      "type": "string",
      "enum": ["stated", "inferred", "assumed"]
    },
    "rationale": {
      "description": "One short clause on why the element takes this form, with the heuristic code in parentheses, e.g. 'no identity outside its owner (HN6)'. Empty when the element is stated outright.",
      "type": "string"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "name", "displayName", "isWeak", "ownerEntity", "weakEvidence", "attributes", "confidence", "rationale"],
      "properties": {
        "evidence": { "$ref": "#/$defs/evidence" },
        "name": { "type": "string" },
        "displayName": { "type": ["string", "null"] },
        "isWeak": { "type": "boolean" },
        "ownerEntity": {
          "description": "Identifying owner of a weak entity; empty string when not weak.",
          "type": "string"
        },
        "weakEvidence": { "$ref": "#/$defs/evidence" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "rationale": { "$ref": "#/$defs/rationale" }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "name", "type", "length", "isIdentifier", "isMultivalued", "isOptional", "confidence", "rationale"],
      "properties": {
        "evidence": { "$ref": "#/$defs/evidence" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["tinyint", "smallint", "int", "long", "decimal", "money", "float", "bool", "char", "string", "text", "date", "time", "datetime", "uuid"]
        },
        "length": {
          "description": "Length for string/char, otherwise null.",
          "type": ["integer", "null"]
        },
        "isIdentifier": { "type": "boolean" },
        "isMultivalued": { "type": "boolean" },
        "isOptional": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "rationale": { "$ref": "#/$defs/rationale" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "name", "displayName", "mapping1", "mapping2", "isIdentifying", "isAggregation", "aggregationEvidence", "attributes", "confidence", "rationale"],
      "properties": {
        "evidence": { "$ref": "#/$defs/evidence" },
        "name": { "type": "string" },
        "displayName": { "type": ["string", "null"] },
        "mapping1": { "$ref": "#/$defs/mapping" },
        "mapping2": { "$ref": "#/$defs/mapping" },
        "isIdentifying": { "type": "boolean" },
        "isAggregation": { "type": "boolean" },
        "aggregationEvidence": { "$ref": "#/$defs/evidence" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "rationale": { "$ref": "#/$defs/rationale" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromEntity", "toEntity", "role", "lowerBound", "upperBound", "boundsStated"],
      "properties": {
        "fromEntity": {
          "description": "Name of an entity, or of an aggregation (its relationship name) that takes part in this relationship.",
          "type": "string"
        },
        "toEntity": {
          "description": "Name of an entity, or of an aggregation (its relationship name) that takes part in this relationship.",
          "type": "string"
        },
        "role": {
          "description": "camelCase navigation name from fromEntity to toEntity, plural when upperBound is many.",
          "type": "string"
        },
        "lowerBound": { "type": "integer", "enum": [0, 1] },
        "upperBound": {
          "description": "-1 for M (many), otherwise a positive integer.",
          "type": "integer"
        },
        "boundsStated": { "type": "boolean" }
      }
    },
    "generalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "superEntity", "subEntities", "isDisjoint", "isTotal", "confidence", "rationale"],
      "properties": {
        "evidence": { "$ref": "#/$defs/evidence" },
        "superEntity": { "type": "string" },
        "subEntities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isDisjoint": { "type": "boolean" },
        "isTotal": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "rationale": { "$ref": "#/$defs/rationale" }
      }
    }
  }
}
